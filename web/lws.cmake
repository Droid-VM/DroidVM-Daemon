# Shared dependency configuration for the native listener and isolated probes.
# The caller supplies a verified, pinned checkout; no configure-time downloads.
if(NOT EXISTS "${DROIDVM_WEB_LWS_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "Set DROIDVM_WEB_LWS_DIR to the verified libwebsockets source")
endif()
set(LWS_WITH_MBEDTLS OFF CACHE BOOL "" FORCE)
set(LWS_WITH_SSL OFF CACHE BOOL "" FORCE)
set(LWS_WITH_STATIC ON CACHE BOOL "" FORCE)
set(LWS_WITH_SHARED OFF CACHE BOOL "" FORCE)
set(LWS_WITHOUT_TESTAPPS ON CACHE BOOL "" FORCE)
set(LWS_WITHOUT_CLIENT ON CACHE BOOL "" FORCE)
set(LWS_WITH_MINIMAL_EXAMPLES OFF CACHE BOOL "" FORCE)
set(LWS_WITH_EXPORT_LWSTARGETS OFF CACHE BOOL "" FORCE)
set(LWS_WITH_CUSTOM_HEADERS ON CACHE BOOL "" FORCE)
set(LWS_IPV6 ON CACHE BOOL "" FORCE)
set(DISABLE_WERROR ON CACHE BOOL "" FORCE)
foreach(feature HTTP2 CGI PLUGINS SYS_SMD SYS_STATE SECURE_STREAMS UPNG GZINFLATE JPEG DLO HTTP_BASIC_AUTH HTTP_DIGEST_AUTH LHP LEJP JSONRPC LEJP_CONF)
    set(LWS_WITH_${feature} OFF CACHE BOOL "" FORCE)
endforeach()
if(ANDROID)
    set(LWS_AVOID_SIGPIPE_IGN ON CACHE BOOL "" FORCE)
endif()
add_subdirectory("${DROIDVM_WEB_LWS_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/libwebsockets" EXCLUDE_FROM_ALL)
