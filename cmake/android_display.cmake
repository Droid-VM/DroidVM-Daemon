if(NOT TARGET droidvm_android_display)
    include("${CMAKE_CURRENT_LIST_DIR}/hugepage_processes.cmake")
    add_library(droidvm_android_display STATIC "${CMAKE_CURRENT_LIST_DIR}/../services/android_display.cpp")
    target_include_directories(droidvm_android_display PUBLIC "${CMAKE_CURRENT_LIST_DIR}/..")
    target_compile_features(droidvm_android_display PUBLIC cxx_std_20)
    target_link_libraries(droidvm_android_display PUBLIC droidvm_tasks droidvm_wire droidvm_hugepage_processes)
    if(MSVC)
        target_compile_options(droidvm_android_display PRIVATE /utf-8 /W4 /WX)
    else()
        target_compile_options(droidvm_android_display PRIVATE -Wall -Wextra -Werror)
    endif()
endif()
function(droidvm_add_android_display_contract)
    if(NOT TARGET droidvm_android_display_contract)
        add_executable(droidvm_android_display_contract "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../web/tests/android_display_contract.cpp")
        target_link_libraries(droidvm_android_display_contract PRIVATE droidvm_web_http droidvm_android_display)
        add_test(NAME android_display_contract COMMAND droidvm_android_display_contract)
    endif()
endfunction()
