if(NOT TARGET droidvm_host_preferences)
    add_library(droidvm_host_preferences STATIC "${CMAKE_CURRENT_LIST_DIR}/../services/host_preferences.cpp")
    target_include_directories(droidvm_host_preferences PUBLIC "${CMAKE_CURRENT_LIST_DIR}/..")
    target_compile_features(droidvm_host_preferences PUBLIC cxx_std_20)
    target_link_libraries(droidvm_host_preferences PUBLIC droidvm_tasks droidvm_identity)
    if(MSVC)
        target_compile_options(droidvm_host_preferences PRIVATE /utf-8 /W4 /WX)
    else()
        target_compile_options(droidvm_host_preferences PRIVATE -Wall -Wextra -Werror)
    endif()
endif()
function(droidvm_add_host_preferences_contract)
    if(NOT TARGET droidvm_host_preferences_contract)
        add_executable(droidvm_host_preferences_contract "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../web/tests/host_preferences_service_contract.cpp")
        target_link_libraries(droidvm_host_preferences_contract PRIVATE droidvm_host_preferences)
        add_test(NAME host_preferences_contract COMMAND droidvm_host_preferences_contract)
    endif()
endfunction()
