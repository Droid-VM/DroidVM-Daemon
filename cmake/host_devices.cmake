if(NOT TARGET droidvm_host_devices)
    add_library(droidvm_host_devices STATIC "${CMAKE_CURRENT_LIST_DIR}/../vm/host_devices.cpp")
    target_include_directories(droidvm_host_devices PUBLIC "${CMAKE_CURRENT_LIST_DIR}/..")
    target_compile_features(droidvm_host_devices PUBLIC cxx_std_20)
    if(MSVC)
        target_compile_options(droidvm_host_devices PRIVATE /utf-8 /W4 /WX)
    else()
        target_compile_options(droidvm_host_devices PRIVATE -Wall -Wextra -Werror)
    endif()
endif()
