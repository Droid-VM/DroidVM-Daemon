if(NOT TARGET droidvm_hugepage_pool)
    add_library(droidvm_hugepage_pool STATIC "${CMAKE_CURRENT_LIST_DIR}/../vm/hugepage.cpp")
    target_include_directories(droidvm_hugepage_pool PUBLIC "${CMAKE_CURRENT_LIST_DIR}/..")
    target_compile_features(droidvm_hugepage_pool PUBLIC cxx_std_20)
endif()
if(NOT TARGET droidvm_hugepages)
    add_library(droidvm_hugepages STATIC "${CMAKE_CURRENT_LIST_DIR}/../services/hugepage.cpp")
    target_include_directories(droidvm_hugepages PUBLIC "${CMAKE_CURRENT_LIST_DIR}/..")
    target_compile_features(droidvm_hugepages PUBLIC cxx_std_20)
    target_link_libraries(droidvm_hugepages PUBLIC droidvm_tasks droidvm_identity droidvm_hugepage_pool)
    if(NOT WIN32)
        target_link_libraries(droidvm_hugepages PUBLIC droidvm_child)
    endif()
endif()
foreach(target droidvm_hugepage_pool droidvm_hugepages)
    if(MSVC)
        target_compile_options(${target} PRIVATE /utf-8 /W4 /WX)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
    endif()
endforeach()
