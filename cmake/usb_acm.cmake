if(NOT TARGET droidvm_usb_acm)
    add_library(droidvm_usb_acm STATIC "${CMAKE_CURRENT_LIST_DIR}/../services/usb_acm.cpp")
    target_include_directories(droidvm_usb_acm PUBLIC "${CMAKE_CURRENT_LIST_DIR}/..")
    target_compile_features(droidvm_usb_acm PUBLIC cxx_std_20)
    target_link_libraries(droidvm_usb_acm PUBLIC droidvm_tasks droidvm_identity)
    if(MSVC)
        target_compile_options(droidvm_usb_acm PRIVATE /utf-8 /W4 /WX)
    else()
        target_compile_options(droidvm_usb_acm PRIVATE -Wall -Wextra -Werror)
    endif()
endif()
function(droidvm_add_usb_acm_service_contract)
    if(NOT TARGET droidvm_usb_acm_service_contract)
        add_executable(droidvm_usb_acm_service_contract "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../web/tests/usb_acm_service_contract.cpp")
        target_link_libraries(droidvm_usb_acm_service_contract PRIVATE droidvm_usb_acm)
        add_test(NAME usb_acm_service_contract COMMAND droidvm_usb_acm_service_contract)
    endif()
endfunction()
