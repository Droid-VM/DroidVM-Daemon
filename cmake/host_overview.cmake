if(NOT TARGET droidvm_host_overview)
    add_library(droidvm_host_overview STATIC "${CMAKE_CURRENT_LIST_DIR}/../services/host_overview.cpp")
    target_include_directories(droidvm_host_overview PUBLIC "${CMAKE_CURRENT_LIST_DIR}/..")
    target_compile_features(droidvm_host_overview PUBLIC cxx_std_20)
    if(MSVC)
        target_compile_options(droidvm_host_overview PRIVATE /utf-8 /W4 /WX)
    else()
        target_compile_options(droidvm_host_overview PRIVATE -Wall -Wextra -Werror)
    endif()
endif()
