# Shared with VMConfig.createWithCustomizeDefaults; fail at build time if absent.
set(DROIDVM_VM_DATA_DIR "${CMAKE_CURRENT_LIST_DIR}/../../app/src/main/assets/data" CACHE PATH "App VM defaults and SoC capability tables")
foreach(kind vm-defaults gunyah)
    set(input "${DROIDVM_VM_DATA_DIR}/${kind}.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
    file(READ "${input}" text)
    string(JSON type TYPE "${text}")
    if(NOT type STREQUAL "OBJECT")
        message(FATAL_ERROR "Invalid ${input}")
    endif()
    string(REPLACE "-" "_" symbol "${kind}")
    set("DROIDVM_${symbol}_JSON" "${text}")
endforeach()
configure_file("${CMAKE_CURRENT_LIST_DIR}/vm_defaults_data.h.in" "${CMAKE_CURRENT_BINARY_DIR}/generated/vm_defaults_data.h" @ONLY)
add_library(droidvm_vm_defaults STATIC "${CMAKE_CURRENT_LIST_DIR}/../vm/defaults.cpp")
target_include_directories(droidvm_vm_defaults PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
target_link_libraries(droidvm_vm_defaults PUBLIC droidvm_wire droidvm_identity)
target_compile_features(droidvm_vm_defaults PUBLIC cxx_std_20)
if(MSVC)
    target_compile_options(droidvm_vm_defaults PRIVATE /utf-8 /W4 /WX)
else()
    target_compile_options(droidvm_vm_defaults PRIVATE -Wall -Wextra -Werror)
endif()
